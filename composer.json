{
    "name": "equipo/ms-departments",
    "description": "Microservicio de gestión de departamentos",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:ci": "mkdir -p reports && XDEBUG_MODE=coverage phpunit --coverage-clover reports/clover.xml"
    }
}
