{
    "name": "equipo/ms-departments",
    "description": "Microservicio de gestión de departamentos",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^8.3",
        "open-telemetry/exporter-zipkin": "^1.4",
        "open-telemetry/sdk": "^1.16",
        "promphp/prometheus_client_php": "^2.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0",
            "ext-apcu": "5.1.24"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
